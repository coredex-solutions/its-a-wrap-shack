# Google Analytics 4 measurement ID — analytics render nothing when unset
NEXT_PUBLIC_GA_ID=

# Enables the /admin content editor. Unset = admin disabled entirely.
ADMIN_PASSWORD=
# Optional separate cookie-signing secret (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=

# Cloudflare R2 — menu photo uploads. Leave ALL FIVE unset for local dev:
# uploads then land in public/uploads/ instead. Set all five for R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL serving the bucket, no trailing slash —
# e.g. https://pub-xxxx.r2.dev or https://media.itsawrapshack.com
R2_PUBLIC_URL=
